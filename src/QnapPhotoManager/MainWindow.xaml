<Window x:Class="QnapPhotoManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindowRoot"
        AutomationProperties.AutomationId="MainWindow"
        Title="Qnap Photo Manager"
        Width="1040"
        Height="920"
        MinWidth="800"
        MinHeight="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Qnap Photo Manager" />
            <TextBlock Foreground="Gray"
                       Text="Safe, review-first photo workflow foundation" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,16" Padding="14"
                Background="#FFF3F4F6" CornerRadius="4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="16,0,0,0"
                        AutomationProperties.AutomationId="ResetSessionButton"
                        Command="{Binding ResetCommand}"
                        Content="Reset entire session"
                        ToolTip="Clears this session's in-memory workflow state. Existing artifacts and quarantine files are not deleted." />
                <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="Workflow state:" />
                <TextBlock AutomationProperties.AutomationId="WorkflowStateText"
                           Margin="8,0,0,0" Text="{Binding WorkflowState}" />
                <TextBlock Margin="28,0,0,0" FontWeight="SemiBold" Text="Session:" />
                <TextBlock Margin="8,0,0,0" Text="{Binding SessionId}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding ConfigurationPageVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox AutomationProperties.AutomationId="ConfigurationPage" Header="Configuration" Margin="0,0,10,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scan root" />
                    <TextBox x:Name="ScanRootBox" Grid.Row="1"
                             AutomationProperties.AutomationId="ScanRootTextBox"
                             IsEnabled="{Binding IsConfigurationEditable}"
                             Text="{Binding ScanRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                            IsEnabled="{Binding IsConfigurationEditable}"
                            Command="{x:Static ApplicationCommands.Paste}" CommandTarget="{Binding ElementName=ScanRootBox}"
                            Content="Paste" />
                    <TextBlock Grid.Row="2" Margin="0,16,0,0" Text="Artifact root" />
                    <TextBox x:Name="ArtifactRootBox" Grid.Row="3"
                             AutomationProperties.AutomationId="ArtifactRootTextBox"
                             IsEnabled="{Binding IsConfigurationEditable}"
                             Text="{Binding ArtifactRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="3" Grid.Column="1" Margin="8,0,0,0"
                            IsEnabled="{Binding IsConfigurationEditable}"
                            Command="{x:Static ApplicationCommands.Paste}" CommandTarget="{Binding ElementName=ArtifactRootBox}"
                            Content="Paste" />
                    <TextBlock Grid.Row="4" Margin="0,16,0,0" Text="Quarantine root" />
                    <TextBox x:Name="QuarantineRootBox" Grid.Row="5"
                             AutomationProperties.AutomationId="QuarantineRootTextBox"
                             IsEnabled="{Binding IsConfigurationEditable}"
                             Text="{Binding QuarantineRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="5" Grid.Column="1" Margin="8,0,0,0"
                            IsEnabled="{Binding IsConfigurationEditable}"
                            Command="{x:Static ApplicationCommands.Paste}" CommandTarget="{Binding ElementName=QuarantineRootBox}"
                            Content="Paste" />
                    <Button Grid.Row="6" Margin="0,24,0,0"
                            AutomationProperties.AutomationId="ConfigureDuplicatesButton"
                            Command="{Binding ConfigureDuplicatesCommand}" Content="Configure and continue to duplicate work" />
                    <Button Grid.Row="7" Margin="0,8,0,0"
                            AutomationProperties.AutomationId="StartDateWorkButton"
                            Command="{Binding StartDateWorkCommand}" Content="Start date work (skip duplicate scan)" />
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" AutomationProperties.AutomationId="DuplicateWorkPage"
                  Header="Duplicate work" Visibility="{Binding DuplicateWorkPageVisibility}">
            <StackPanel Margin="20">
                <TextBlock TextWrapping="Wrap" Text="Run a read-only scan, review every duplicate group, then validate decisions before producing a dry-run." />
                <WrapPanel Margin="0,20,0,0">
                    <Button AutomationProperties.AutomationId="ScanDuplicatesButton" Command="{Binding ScanDuplicatesCommand}" Content="Scan / review" />
                    <Button AutomationProperties.AutomationId="OpenDuplicateReviewerButton" Margin="8,0,0,0" Command="{Binding OpenDuplicateReviewerCommand}" Content="Open reviewer" />
                    <Button AutomationProperties.AutomationId="ValidateDuplicateReviewButton" Margin="8,0,0,0" Command="{Binding ValidateDuplicateReviewCommand}" Content="Validate review" />
                    <Button AutomationProperties.AutomationId="DuplicateDryRunButton" Margin="8,0,0,0" Command="{Binding DuplicateDryRunCommand}" Content="Dry-run" />
                </WrapPanel>
                <TextBlock Margin="0,16,0,0" Foreground="Gray" Text="{Binding DuplicateArtifactSummary}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Foreground="Gray" Text="{Binding DuplicateReviewValidationSummary}" TextWrapping="Wrap" />
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding CopyDuplicateSnapshotNameCommand}" Content="Copy" />
                    <TextBox IsReadOnly="True" AutomationProperties.AutomationId="DuplicateSnapshotNameTextBox"
                             Text="{Binding DuplicateSnapshotName, Mode=OneWay}" />
                </DockPanel>
                <WrapPanel Margin="0,16,0,0">
                    <CheckBox AutomationProperties.AutomationId="SnapshotConfirmedCheckBox"
                              IsEnabled="{Binding CanConfirmDuplicateSnapshot}" IsChecked="{Binding DuplicateSnapshotConfirmed}"
                              Content="Confirm QNAP snapshot for quarantine" />
                    <Button AutomationProperties.AutomationId="DuplicateApplyButton" Margin="12,0,0,0"
                            Command="{Binding DuplicateApplyCommand}" Content="Apply quarantine" />
                    <Button AutomationProperties.AutomationId="DuplicateVerifyButton" Margin="8,0,0,0"
                            Command="{Binding DuplicateVerifyCommand}" Content="Verify and continue to dates" />
                </WrapPanel>
                <TextBlock Margin="0,14,0,0" Foreground="Gray" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                <GroupBox Header="Selective duplicate undo" Margin="0,20,0,0">
                    <DockPanel Margin="10">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button AutomationProperties.AutomationId="LoadDuplicateUndoButton" Command="{Binding LoadDuplicateUndoCommand}" Content="Refresh active moves" />
                            <Button AutomationProperties.AutomationId="UndoSelectedDuplicatesButton" Margin="8,0,0,0"
                                    Command="{Binding UndoSelectedDuplicatesCommand}" Content="Undo selected" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding DuplicateUndoItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay}" />
                                <DataGridTextColumn Header="Moved" Binding="{Binding MovedAt}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Quarantine" Binding="{Binding Destination}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" AutomationProperties.AutomationId="DateWorkPage"
                  Header="Date work" Visibility="{Binding DateWorkPageVisibility}" Margin="0,0,0,12">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <Button AutomationProperties.AutomationId="ScanDatesButton"
                            Command="{Binding ScanDatesCommand}" Content="Scan" />
                    <Button AutomationProperties.AutomationId="CreateDateSnapshotButton"
                            Margin="8,0,0,0" Command="{Binding CreateDateSnapshotCommand}" Content="Snapshot" />
                    <CheckBox AutomationProperties.AutomationId="DateSnapshotConfirmedCheckBox"
                              Margin="14,4,0,0"
                              IsEnabled="{Binding CanConfirmDateSnapshot}"
                              IsChecked="{Binding DateSnapshotConfirmed}" Content="Confirm QNAP snapshot for dates" />
                    <Button AutomationProperties.AutomationId="ApplyDatesButton"
                            Margin="14,0,0,0" Command="{Binding ApplyDatesCommand}" Content="Apply dates" />
                    <Button AutomationProperties.AutomationId="LoadUndoButton"
                            Margin="8,0,0,0" Command="{Binding LoadUndoCommand}" Content="Undo history" />
                    <Button AutomationProperties.AutomationId="UndoSelectedButton"
                            Margin="8,0,0,0" Command="{Binding UndoSelectedCommand}" Content="Undo" />
                </WrapPanel>
                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding DateItems}" AutoGenerateColumns="False"
                              IsReadOnly="False" CanUserAddRows="False" HeadersVisibility="Column"
                              SelectedItem="{Binding SelectedDateItem, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Decision"
                                ItemsSource="{Binding DataContext.DateDecisionOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedItemBinding="{Binding Decision, Mode=TwoWay}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Proposed UTC" Binding="{Binding ProposedCaptureTimeUtc}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Proposed local" Binding="{Binding ProposedLocalTime}" IsReadOnly="True" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Selected item evidence" />
                            <Image AutomationProperties.AutomationId="DatePreviewImage"
                                   Source="{Binding DatePreview}" MaxHeight="180" Stretch="Uniform" Margin="0,8,0,8" />
                            <TextBlock AutomationProperties.AutomationId="SelectedDatePathText"
                                       Text="{Binding SelectedDateItem.Path}" TextWrapping="Wrap" />
                            <TextBlock AutomationProperties.AutomationId="DateEvidenceSummaryText"
                                       Margin="0,8,0,0" Text="{Binding DateEvidenceSummary}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedDateItem.Reason}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedDateItem.SizeDescription, StringFormat=Size: {0}}" />
                            <TextBlock Text="{Binding SelectedDateItem.RawValue, StringFormat=Raw value: {0}}" />
                            <TextBlock Text="{Binding SelectedDateItem.ParsedFilenameToken, StringFormat=Parsed filename token: {0}}" />
                            <TextBlock Text="{Binding SelectedDateItem.TimezoneDescription, StringFormat=Timezone interpretation: {0}}" />
                            <TextBlock Text="{Binding SelectedDateItem.CurrentCreationTimeUtc, StringFormat=Current creation UTC: {0}}" />
                            <TextBlock Text="{Binding SelectedDateItem.CurrentLastWriteTimeUtc, StringFormat=Current last write UTC: {0}}" />
                            <TextBlock Text="{Binding SelectedDateItem.Policy, StringFormat=Apply policy: {0}}" />
                            <GroupBox Header="Date undo history" Margin="0,16,0,0">
                                <DataGrid ItemsSource="{Binding UndoItems}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="160">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay}" />
                                        <DataGridTextColumn Header="Applied" Binding="{Binding AppliedAt}" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding DateSummary}" />
                    <TextBlock Foreground="Gray" Text="{Binding DateTimezonePolicy}" TextWrapping="Wrap" />
                    <TextBlock Foreground="Gray" Text="{Binding DateSnapshotName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="Gray" Text="{Binding DateReportPath}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="4" Margin="0,0,0,0">
            <StatusBarItem>
                <TextBlock AutomationProperties.AutomationId="StatusMessageText" Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
